@model IList<Product>
@{
    ViewData["Title"] = "Product Administration";
}
<h1>@ViewData["Title"]</h1>

<a asp-action="Create">Create New Product</a>

@if (Model != null && Model.Count > 0)
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col">@nameof(Product.Id)</th>
                <th scope="col">@nameof(Product.Name)</th>
                <th scope="col">@nameof(Product.Description)</th>
                <th scope="col">@nameof(Product.Price)</th>
                <th scope="col">@nameof(Product.ImageUrl)</th>
                <th scope="col">Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <th scope="row">@product.Id</th>
                    <td>@product.Name</td>
                    <td>@product.Description</td>
                    <td>@product.Price</td>
                    <td>@product.ImageUrl</td>
                    <td>
                        <form asp-action="Delete" asp-route-id="@product.Id" method="post">
                            <!--<input type="hidden" name="id" value="@*@product.Id*@" />-->
                            <input type="submit" value="Delete" onclick="return ConfirmDelete();" class="btn btn-danger" />
                        </form>
                    </td>
                </tr>
            }

        </tbody>
    </table>
}

@section Scripts
{
    <script src="~/js/dialogs.js"></script>
}
