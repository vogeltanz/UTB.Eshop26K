@model IList<Product>
@{
    ViewData["Title"] = "Product Administration";
}
<h1>@ViewData["Title"]</h1>

@if (Model != null && Model.Count > 0)
{
    <table class="table">
      <thead>
        <tr>
          <th scope="col">@nameof(Product.Id)</th>
          <th scope="col">@nameof(Product.Name)</th>
          <th scope="col">@nameof(Product.Description)</th>
          <th scope="col">@nameof(Product.Price)</th>
          <th scope="col">@nameof(Product.ImageUrl)</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var product in Model)
        { 
            <tr>
              <th scope="row">@product.Id</th>
              <td>@product.Name</td>
              <td>@product.Description</td>
              <td>@product.Price</td>
              <td>@product.ImageUrl</td>
            </tr>
        }

      </tbody>
    </table>
}
